# Server-side TMDB API Read Access Token. Never use this as VITE_TMDB_READ_TOKEN in production.
TMDB_READ_TOKEN=your_tmdb_api_read_access_token

# Optional: enables online YouTube search for metadata/trailers.
YOUTUBE_API_KEY=your_youtube_data_api_key
PORT=8000

# Native MovieBox internal API integration.
# Keep the gateway secret server-side; never expose it as VITE_*.
MOVIEBOX_INTERNAL_BASE_URL=https://apig.inmoviebox.com
MOVIEBOX_GATEWAY_SECRET=your_authorized_gateway_secret
MOVIEBOX_APP_ID=4U01pxRu278GqCZKY9
MOVIEBOX_REGION=NG
MOVIEBOX_LANG=en
MOVIEBOX_GUEST_TOKEN=
