# Optional: enables online YouTube trailer search through the Python API.
YOUTUBE_API_KEY=your_youtube_data_api_key
PORT=8000
# Your actual custom VidSrc player domain, e.g. https://player.example.com
# Do not put vidsrc-ip.com here; that is the DNS CNAME target.
VITE_VIDSRC_BASE=https://player.example.com
